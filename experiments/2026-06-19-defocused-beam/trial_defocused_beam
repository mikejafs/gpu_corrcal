import numpy as np
import matplotlib.pyplot as plt
from scipy.special import j0

def defocused_beam(theta, freq_hz, D=6.0, f_over_D=0.4,
                   delta_z=0.0, edge_taper_db=-12.0, n_r=400):
    """Power beam of a circular dish with axial feed offset delta_z [m].
    Returns Airy exactly when edge_taper_db=0 and delta_z=0."""
    lam = 2.998e8 / freq_hz
    a, f = D/2.0, f_over_D*D
    r   = np.linspace(1e-9, a, n_r)
    psi = 2.0*np.arctan(r/(2.0*f))                       # feed angle vs radius
    g   = 10.0**((edge_taper_db/20.0)*(r/a)**2)          # amplitude taper
    phase = (2*np.pi/lam)*delta_z*(1.0 - np.cos(psi))    # defocus, piston removed
    ap  = g*np.exp(1j*phase)

    u  = (2*np.pi/lam)*np.sin(np.atleast_1d(theta))      # (n_theta,)
    Jm = j0(np.outer(u, r))                              # (n_theta, n_r)
    E  = Jm @ (ap*r) * (r[1]-r[0])
    B  = np.abs(E)**2
    return B/B.max()


if __name__ == "__main__":
    theta_vals = np.linspace(-np.pi/2, np.pi/2)
    freq_hz = 1200 #MHz

    beam = defocused_beam(theta_vals, freq_hz)
    plt.plot(beam)
    plt.show()