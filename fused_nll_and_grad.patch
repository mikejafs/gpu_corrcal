+# ---------------------------------------------------------------------------
+# 3. finite differences of the fused objective
+# ---------------------------------------------------------------------------
+@pytest.mark.parametrize("scale", [1.0, 2.0])
+def test_fused_fd(rc, n_eig, n_src, seed, scale):
+    if rc != (6, 8):
+        pytest.skip("finite differences on the 6x8 grid only")
+    _, data, cov, _, _, _, a1_d, a2_d, gws = _gpu_problem(rc, n_eig, n_src, seed)
+    nws = NllWorkspace()
+    phs = 0.5
+    n_ant = rc[0] * rc[1]
+
+    # Gains near 1 (a realistic operating point). Random gains in [0, 1) put
+    # some |g_k1 g_k2| near zero, where the objective's curvature wrecks
+    # finite differences.
+    rng = np.random.default_rng(seed + 2)
+    g = 1 + 0.1 * rng.standard_normal(n_ant) + 0.1j * rng.standard_normal(n_ant)
+    x = np.empty(2 * n_ant)
+    x[0::2], x[1::2] = g.real, g.imag
+    x *= scale
+
+    f = lambda y: nll_and_grad(y, cov, data, a1_d, a2_d, scale, phs, gws, nws)[0]
+    _, grad = nll_and_grad(x, cov, data, a1_d, a2_d, scale, phs, gws, nws)
+
+    worst = 0.0
+    for trial in range(3):
+        v = rng.standard_normal(x.size)
+        v /= np.linalg.norm(v)
+        an = float(grad @ v)
+        errs = []
+        for h in (1e-2, 3e-3, 1e-3, 3e-4):
+            fd = (f(x + h * v) - f(x - h * v)) / (2 * h)
+            errs.append(abs(fd - an) / abs(an))
+        best = min(errs)
+        worst = max(worst, best)
+        print(f"\n  scale={scale} dir {trial}: grad.v={an:.6e}  "
+              f"rel err per h={['%.1e' % e for e in errs]}  best={best:.1e}")
+    ok, line = summarize(f"fd (scale={scale})", worst, TOL_FD)
+    print(f"  {line}")
+    assert ok, line
